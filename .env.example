# ==============================================================================
# AFRICA CHINA CHAIRMEN OF BUSINESS FORUM (ACCBCF)
# Production & Environment Variables Template
# ==============================================================================

# 1. Environment Mode
NODE_ENV=production
PORT=3000

# 2. Live Canonical Server URL
# The public HTTPS domain where your website and Payload CMS are served.
# Do NOT include a trailing slash.
NEXT_PUBLIC_SERVER_URL=https://www.africachinachairmenforum.com

# 3. Payload CMS Secret Key
# A strong, cryptographically secure 64-character secret used to sign session cookies and JWTs.
# Generate a new random secret using terminal:
#   openssl rand -hex 32
PAYLOAD_SECRET=your-64-character-cryptographically-secure-random-secret-key-here

# 4. Production PostgreSQL Database URI
# Required for live multi-user concurrency and high availability.
# When DATABASE_URI begins with 'postgres', Payload CMS automatically uses @payloadcms/db-postgres.
# Compatible with Neon, Supabase, Railway, Render, AWS RDS, DigitalOcean Managed Postgres.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URI=postgresql://postgres:YOUR_STRONG_PASSWORD@your-postgres-host.com:5432/accbcf_production?sslmode=require

# ==============================================================================
# Optional Cloud Object Storage (for Serverless / Vercel Deployments)
# ==============================================================================
# If deploying to serverless platforms where local disk is read-only/ephemeral,
# you can configure AWS S3 or Cloudflare R2:
# S3_BUCKET=accbcf-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
